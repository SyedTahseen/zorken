<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"/>
  <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE"/>
  <uses-permission android:name="android.permission.VIBRATE"/>
  <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC"/>
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
  <uses-permission android:name="android.permission.WAKE_LOCK"/>
  <application android:name=".ZorkenApp" android:label="Zorken" android:icon="@mipmap/ic_launcher" android:roundIcon="@mipmap/ic_launcher" android:theme="@android:style/Theme.DeviceDefault.NoActionBar">
    <meta-data android:name="xposedmodule" android:value="true"/>
    <meta-data android:name="xposeddescription" android:value="Hide apps/files after wrong unlock attempts"/>
    <meta-data android:name="xposedminversion" android:value="93"/>
    <meta-data android:name="xposedscope" android:resource="@array/scope"/>
    <activity android:name=".MainActivity" android:exported="true">
      <intent-filter><action android:name="android.intent.action.MAIN"/><category android:name="de.robv.android.xposed.category.MODULE_SETTINGS"/></intent-filter>
    </activity>
    <activity-alias android:name=".LauncherAlias" android:targetActivity=".MainActivity" android:enabled="true" android:exported="true">
      <intent-filter><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.LAUNCHER"/></intent-filter>
    </activity-alias>
    <service android:name=".LockService" android:exported="false" android:foregroundServiceType="dataSync"/>
    <service android:name=".EncryptJob" android:permission="android.permission.BIND_JOB_SERVICE" android:exported="false"/>
    <receiver android:name=".FileReceiver" android:exported="true">
      <intent-filter>
        <action android:name="com.zorken.HIDE_FILES"/>
        <action android:name="com.zorken.PONG"/>
        <action android:name="com.zorken.ACK"/>
        <action android:name="com.zorken.LOG"/>
        <action android:name="android.intent.action.BOOT_COMPLETED"/>
      </intent-filter>
    </receiver>
  </application>
</manifest>
